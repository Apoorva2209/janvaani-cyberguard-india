# ==============================================================================
# CYBERGUARD INDIA - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# ⚠️ CRITICAL SECURITY WARNING:
# NEVER commit a .env file with real production credentials, private keys,
# or API secrets to version control! This file (.env.example) serves strictly as
# a safe template. Copy this to .env locally and populate with strong, unique secrets.
# ==============================================================================

# Application Environment ('development' | 'staging' | 'production')
NODE_ENV=development

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Next.js)
# ------------------------------------------------------------------------------
# Public API base URL accessed from browser
# Warning: NEVER expose private backend secrets under NEXT_PUBLIC_* variables!
NEXT_PUBLIC_API_URL=http://localhost:3000
FRONTEND_PORT=3001

# ------------------------------------------------------------------------------
# BACKEND & SERVER CONFIGURATION (Fastify)
# ------------------------------------------------------------------------------
PORT=3000
CORS_ORIGIN=http://localhost:3001

# Primary Database (PostgreSQL 16)
POSTGRES_DB=cyberguard
POSTGRES_USER=cyberguard_app
POSTGRES_PASSWORD=ReplaceWithStrongPostgresPassword2026!
DATABASE_URL=postgresql://cyberguard_app:ReplaceWithStrongPostgresPassword2026!@localhost:5432/cyberguard?schema=public

# Redis Cache & Session Store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ReplaceWithStrongRedisPassword2026!

# MinIO / S3 Object Storage (Private Buckets)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=cg_minio_admin
MINIO_ROOT_PASSWORD=ReplaceWithStrongMinioPassword2026!
MINIO_USE_SSL=false
MINIO_BUCKET_UPLOADS=cyberguard-quarantine-uploads

# ClamAV Malware Scanner
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ------------------------------------------------------------------------------
# CRYPTOGRAPHIC KEYS & SECRETS
# ------------------------------------------------------------------------------
# JWT Secret: Minimum 256 bits (32+ bytes) random high-entropy key
# Example generation: openssl rand -base64 32
JWT_SECRET=ReplaceWithSecure256BitKeyMinimum32CharactersLength!
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Cookie Signing Key (AES-256 GCM)
COOKIE_SECRET=ReplaceWithSecureCookieEncryptionKeyMin32Chars!

# ------------------------------------------------------------------------------
# EXTERNAL INTEGRATIONS & TELEMETRY (OPTIONAL / MOCK IN DEV)
# ------------------------------------------------------------------------------
# CERT-In / Threat Intelligence Feed API Key
THREAT_FEED_API_KEY=mock-threat-intel-key-dev-only

# AI Model Inference Endpoint
AI_INFERENCE_ENDPOINT=http://localhost:8000/v1/predict
