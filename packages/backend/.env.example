# Node Environment
NODE_ENV=development
PORT=3000

# Database & Cache
DATABASE_URL=postgresql://cyberguard:cyberguard_secret@localhost:5432/cyberguard_db?schema=public
REDIS_URL=redis://localhost:6379

# Cryptographic Secrets (minimum 32 characters)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_entropy_test
JWT_REFRESH_SECRET=super_secret_refresh_key_at_least_32_characters_long
SESSION_SECRET=super_secret_session_key_at_least_32_characters_long_entropy
CSRF_SECRET=super_secret_csrf_key_at_least_32_characters_long_entropy_test

# S3 Object Storage (Evidence & Document Uploads)
S3_BUCKET=cyberguard-evidence-vault
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_ACCESS_KEY=MINIO_OR_AWS_ACCESS_KEY
S3_SECRET_KEY=MINIO_OR_AWS_SECRET_KEY_MINIMUM_16_CHARS

# Bhashini Sovereign Translation & NLP Services
BHASHINI_API_KEY=bhashini_api_key_sample
BHASHINI_PIPELINE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://cyberguard.gov.in

# Operational Configurations
MAX_UPLOAD_SIZE_MB=10
FILE_RETENTION_DAYS=30
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info
